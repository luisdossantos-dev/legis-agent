# ==========================================
# Legis Agent — Variables de Entorno
# ==========================================
# Copiá este archivo como .env y completá los valores.

# ── Server ─────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=["*"]

# ── LiteLLM ───────────────────────────────
# API key del proveedor principal (OpenAI, Anthropic, etc.)
LITELLM_API_KEY=sk-your-api-key-here
# Modelo primario
LITELLM_MODEL=openai/gpt-4o
# Modelo de fallback (se usa si el primario falla)
LITELLM_FALLBACK_MODEL=anthropic/claude-3-haiku
LITELLM_MAX_TOKENS=4096
LITELLM_TEMPERATURE=0.2

# ── Vector Store ───────────────────────────
# Opciones: pgvector (dev), pinecone (prod), qdrant
VECTOR_STORE_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=legis-agent

# ── PostgreSQL / pgvector ──────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/legisagent

# ── Embeddings ─────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Langfuse (Observabilidad) ──────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Almacenamiento ─────────────────────────
UPLOAD_DIR=./uploads
