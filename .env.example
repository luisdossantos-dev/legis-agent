# ==========================================
# Legis Agent — Variables de Entorno (Raíz)
# ==========================================
# Usá este archivo o el de backend/.env.example

# ── Backend ─────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=["*"]

# ── LiteLLM ───────────────────────────────
LITELLM_API_KEY=sk-your-api-key-here
LITELLM_MODEL=openai/gpt-4o
LITELLM_FALLBACK_MODEL=anthropic/claude-3-haiku
LITELLM_MAX_TOKENS=4096
LITELLM_TEMPERATURE=0.2

# ── Vector Store ───────────────────────────
VECTOR_STORE_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legis-agent

# ── PostgreSQL ─────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/legisagent

# ── Embeddings ─────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Langfuse ───────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Almacenamiento ─────────────────────────
UPLOAD_DIR=./uploads
